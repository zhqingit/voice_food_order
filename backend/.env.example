# Copy to backend/.env (gitignored). Both secrets are required; generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# Gemini API key (only needed when GEMINI_USE_VERTEX / VOICE_USE_VERTEX are false)
GEMINI_API_KEY=

# Local dev only (used by docker-compose.override.yml)
GOOGLE_ADC_PATH=
