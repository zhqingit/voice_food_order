# Copy to backend/.env (gitignored). Both secrets are required; generate each with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_TOKEN_PEPPER=

# Gemini API key (only needed when GEMINI_USE_VERTEX / VOICE_USE_VERTEX are false)
GEMINI_API_KEY=

# Local dev only (used by docker-compose.override.yml)
GOOGLE_ADC_PATH=

# Stripe (test mode keys while testing). STRIPE_WEBHOOK_SECRET comes from
# `stripe listen` locally, or the Dashboard webhook endpoint on the server.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Server only: explicit origin of the store portal (leave empty locally).
CORS_ORIGINS=
